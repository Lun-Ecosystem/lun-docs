# Closed list of the remote commands a session may play on a production host.
# Generic example: the real list lives outside the repository, in the file named by LUN_PROD_SSH_ALLOW_FILE.
# The launcher plays a line by its number in this file: node prod-run.mjs <number> [arguments...] (see --list).
#
# One command per line; blank lines and lines starting with # are ignored.
# A line is made of plain words, single quotes to group a word, and | toward grep, wc -c or wc -l.
# No ; && || & redirection, variable, substitution or double quote: such a line stops the launcher.
# Jokers, each standing alone for exactly one word, filled by the arguments in their order:
#   <app>      a name: [a-z0-9][a-z0-9_-]{0,39}
#   <version>  a version: 1.2.3
#   <int>      a number: 1 to 6 digits
#   <path>     an absolute path made of [A-Za-z0-9._/-], without "..", behind stat only

# Services, containers, volumes: read.
docker compose -f /srv/app/compose.yaml config --services
docker ps --format '{{.Names}} {{.Status}}'
docker inspect --format '{{.State.Health.Status}}' <app>
docker volume ls --format '{{.Name}}'
docker logs --tail <int> <app> | grep -F 'Base copiée'

# Start, stop, restart one named app.
docker compose -f /srv/app/compose.yaml up -d <app>
docker compose -f /srv/app/compose.yaml stop <app>
docker compose -f /srv/app/compose.yaml restart <app>

# Pull the images, then leave the registry.
docker compose -f /srv/app/compose.yaml pull
docker logout registry.example.test

# The deployment script: an app and a version, or the rollback.
/srv/app/deploy.sh <app> <version>
/srv/app/deploy.sh <app> --rollback

# The time Node reads in a container.
docker exec <app> node -p 'new Date().toString()'

# The length of one value in an environment file, never its content.
grep ^APP_KEY= /srv/app/app.env | wc -c

# Create a named volume; the rights of a file.
docker volume create <app>
stat -c %a <path>
