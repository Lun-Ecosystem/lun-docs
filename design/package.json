{
  "name": "lun-docs-design",
  "private": true,
  "type": "module",
  "description": "Le kit commun et sa galerie locale. Les dépendances de design/ ne concernent pas la racine du dépôt.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "scripts": {
    "galerie": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format:check": "prettier --check galerie *.ts *.json",
    "format": "prettier --write galerie *.ts *.json"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lucide/svelte": "1.64.0",
    "bits-ui": "2.20.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
